{
  "name": "@mapcraft/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"fs.mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mapcraft --local",
    "db:migrate:remote": "wrangler d1 migrations apply mapcraft --remote"
  },
  "dependencies": {
    "@mapcraft/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260703.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  }
}
