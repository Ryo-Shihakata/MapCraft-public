{
  "name": "mapcraft",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP_ROOM", "class_name": "MapRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mapcraft",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "THUMBS", "bucket_name": "mapcraft-thumbnails" }],
  "vars": { "BETTER_AUTH_URL": "https://mapcraft.<your-subdomain>.workers.dev" },
  "observability": { "enabled": true }
}
